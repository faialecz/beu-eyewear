generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Category {
  slug          String        @id
  name          String
  description   String
  subcategories Subcategory[]
  products      Product[]
}

model Subcategory {
  slug         String    @id
  categorySlug String
  name         String
  category     Category  @relation(fields: [categorySlug], references: [slug])
  products     Product[]

  @@index([categorySlug])
}

model Product {
  slug            String   @id
  name            String
  description     String
  price           Int
  categorySlug    String
  subcategorySlug String
  frameMaterial   String?
  lensOption      String?
  frameShape      String?
  colors          String[]
  warrantyYears   Int
  imageUrl        String?
  stockQuantity   Int      @default(0)

  category    Category   @relation(fields: [categorySlug], references: [slug])
  subcategory Subcategory @relation(fields: [subcategorySlug], references: [slug])

  @@index([categorySlug])
  @@index([subcategorySlug])
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
}

enum PaymentMethod {
  CARD
  WALLET
  BANK
}

enum ShippingMethod {
  STANDARD
  EXPRESS
}

enum Role {
  CUSTOMER
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now())

  // Set once the user confirms the link we email them (or resets their password).
  emailVerifiedAt DateTime?

  sessions       Session[]
  orders         Order[]
  savedAddresses SavedAddress[]
  authTokens     AuthToken[]
}

enum AuthTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

// Single-use emailed links. Like Session, only the SHA-256 of the token is
// stored, so a leaked database can't be replayed as working links.
model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  type      AuthTokenType
  tokenHash String        @unique
  // EMAIL_VERIFY only: the address to switch to once confirmed (an email change).
  newEmail  String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

// Several per user, at most one default (kept by the app, in a transaction).
// Field lengths are enforced in the app (lib/checkout/address.ts), same as the
// Order address snapshot.
model SavedAddress {
  id        String   @id @default(cuid())
  userId    String
  label     String?
  isDefault Boolean  @default(false)
  fullName  String
  address   String
  city      String
  province  String
  zip       String
  phone     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Money columns are whole pesos, matching Product.price.
model Order {
  id             String         @id @default(cuid())
  number         Int            @unique @default(autoincrement())
  userId         String
  status         OrderStatus    @default(PENDING)
  paymentMethod  PaymentMethod
  paymentStatus  PaymentStatus  @default(UNPAID)
  shippingMethod ShippingMethod
  subtotal       Int
  shippingFee    Int
  total          Int

  // Address snapshot: later edits to a saved address must not rewrite history.
  shipName     String
  shipAddress  String
  shipCity     String
  shipProvince String
  shipZip      String
  shipPhone    String

  createdAt DateTime @default(now())

  user  User        @relation(fields: [userId], references: [id])
  items OrderItem[]

  @@index([userId, createdAt])
}

// Snapshots name/color/price and deliberately has no FK to Product: products
// can be hard-deleted or repriced after the order is placed.
model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productSlug String
  name        String
  color       String?
  unitPrice   Int
  quantity    Int

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}
